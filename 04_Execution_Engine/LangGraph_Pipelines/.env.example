# Copy to .env (in this directory or the project root) and set secrets locally.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=${LANGSMITH_API_KEY}
LANGCHAIN_PROJECT=Triton_AI_Corp_Master

# Recommended local runtime: Ollama's OpenAI-compatible server.
# In Docker use http://host.docker.internal:11434/v1 instead.
OPENAI_API_BASE=http://localhost:11434/v1
# Ollama does not require a key locally; this placeholder satisfies OpenAI-compatible clients.
OPENAI_API_KEY=ollama

# Set these identifiers exactly as they appear in `ollama list`.
# They are invoked sequentially, never simultaneously.
TRITON_DEFAULT_MODEL=gemma3:4b
TRITON_VALIDATOR_MODEL=<approved-independent-standard-or-flagship-model>
TRITON_SPECIALIST_MODEL=qwen3:4b
# Governance meetings use the specialist model for participants and chair, and
# the validator model for the independent challenger. Cloud escalation remains
# disabled unless the separate approval fields below are explicitly set.
TRITON_GOVERNANCE_MODEL=${TRITON_SPECIALIST_MODEL}
TRITON_GOVERNANCE_CHAIR_MODEL=${TRITON_GOVERNANCE_MODEL}
TRITON_GOVERNANCE_CHALLENGER_MODEL=${TRITON_VALIDATOR_MODEL}
TRITON_CORP_BUILDER_MODEL=${TRITON_SPECIALIST_MODEL}
TRITON_CORP_BUILDER_CONTROLLER_MODEL=${TRITON_VALIDATOR_MODEL}
# Keep local role outputs bounded; detailed evidence belongs in linked artifacts.
TRITON_MAX_OUTPUT_TOKENS=600
# Default: release local model VRAM after a completed live Triton command.
# Use performance only for a reviewed, temporary evaluation session.
TRITON_GPU_RELIEF_MODE=on_demand

# Evidence-led model quality policy. Local backups may be selected only after
# repeated, recorded quality failures; no unknown model is downloaded automatically.
TRITON_MIN_QUALITY_SCORE=0.80
TRITON_MIN_QUALITY_SAMPLES=5
TRITON_MAX_CONSECUTIVE_CRITICAL_FAILURES=3
TRITON_AUTO_MODEL_ROUTING_ENABLED=true
TRITON_PRIMARY_BACKUP_MODEL=qwen3:4b
TRITON_VALIDATOR_BACKUP_MODEL=qwen3:4b
TRITON_SPECIALIST_BACKUP_MODEL=gemma3:4b

# Capability classes are admitted through MODEL_CLASS_REGISTRY.json. They are
# deliberately blank until a version, provider, data route, benchmark snapshot,
# Triton acceptance evidence, cost cap, and human approval are recorded.
TRITON_FLAGSHIP_MODEL=
TRITON_STANDARD_MODEL=
TRITON_WORKER_MODEL=

# Online escalation: local -> EU/EWR -> US/CN only as an approved exception.
# Never place a production key in this example.
TRITON_EU_FALLBACK_ENABLED=false
TRITON_EU_FALLBACK_APPROVED=false
TRITON_EU_FALLBACK_PROVIDER=
TRITON_EU_FALLBACK_BASE_URL=
TRITON_EU_FALLBACK_MODEL=
TRITON_EU_FALLBACK_API_KEY=
TRITON_US_FALLBACK_ENABLED=false
TRITON_US_FALLBACK_APPROVED=false
TRITON_US_FALLBACK_PROVIDER=
TRITON_US_FALLBACK_BASE_URL=
TRITON_US_FALLBACK_MODEL=
TRITON_US_FALLBACK_API_KEY=
TRITON_CN_FALLBACK_ENABLED=false
TRITON_CN_FALLBACK_APPROVED=false
TRITON_CN_FALLBACK_PROVIDER=
TRITON_CN_FALLBACK_BASE_URL=
TRITON_CN_FALLBACK_MODEL=
TRITON_CN_FALLBACK_API_KEY=
TRITON_ONLINE_DATA_CAPSULE_ID=
TRITON_ONLINE_DATA_CAPSULE_PATH=
TRITON_ONLINE_DATA_CAPSULE_APPROVED=false
TRITON_ONLINE_EXECUTION_APPROVED=false

# Optional alternative: a LiteLLM proxy can replace OPENAI_API_BASE.
# OPENAI_API_BASE=http://localhost:4000/v1

# LangSmith Tracing aktivieren
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="dein_langsmith_api_key_hier"
LANGCHAIN_PROJECT="Triton_AI_Corp_Master_Graph"

# Lokale Ollama-Modelle; sie werden von Triton sequenziell angesprochen.
TRITON_DEFAULT_MODEL="gemma3:4b"
TRITON_VALIDATOR_MODEL="UNCONFIGURED"
TRITON_SPECIALIST_MODEL="qwen3:4b"
TRITON_MIN_QUALITY_SCORE="0.80"
TRITON_MIN_QUALITY_SAMPLES="5"
TRITON_MAX_CONSECUTIVE_CRITICAL_FAILURES="3"
TRITON_AUTO_MODEL_ROUTING_ENABLED="true"
TRITON_PRIMARY_BACKUP_MODEL="qwen3:4b"
TRITON_VALIDATOR_BACKUP_MODEL="qwen3:4b"
TRITON_SPECIALIST_BACKUP_MODEL="gemma3:4b"
TRITON_EU_FALLBACK_ENABLED="false"
TRITON_EU_FALLBACK_APPROVED="false"
TRITON_EU_FALLBACK_BASE_URL=""
TRITON_EU_FALLBACK_MODEL=""
TRITON_NON_EU_FALLBACK_ENABLED="false"
TRITON_NON_EU_FALLBACK_APPROVED="false"
TRITON_NON_EU_FALLBACK_REGION=""
TRITON_NON_EU_FALLBACK_BASE_URL=""
TRITON_NON_EU_FALLBACK_MODEL=""
TRITON_ONLINE_DATA_CAPSULE_ID=""
TRITON_ONLINE_DATA_CAPSULE_PATH=""
TRITON_ONLINE_DATA_CAPSULE_APPROVED="false"
TRITON_ONLINE_EXECUTION_APPROVED="false"

# Dein lokaler LiteLLM Proxy / Ollama / OpenAI Key
OPENAI_API_BASE="http://localhost:11434/v1"
OPENAI_API_KEY="sk-anything"
